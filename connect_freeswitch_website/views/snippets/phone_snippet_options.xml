<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="phone_snippet_options" inherit_id="website.snippet_options">
        <xpath expr="//div[@data-js='Box']" position="before">
            <div data-js="ConnectPhoneStatus" data-selector=".s_connect_phone_status">
                <we-select string="Phone Number"
                           data-name="phone_number_opt"
                           data-attribute-name="numberId"/>
                <we-checkbox string="Show Time"
                             title="Show until when the number is available, or when it opens again"
                             data-select-data-attribute="false|true"
                             data-attribute-name="showTime"/>
                <we-checkbox string="Phone Link"
                             title="Link the phone number with tel: prefix"
                             data-select-data-attribute="false|true"
                             data-attribute-name="linkPhone"/>
                <we-urlpicker string="Status Link"
                              title="Web page opened when clicking the status indicator"
                              placeholder="e.g. /contactus"
                              data-select-data-attribute=""
                              data-attribute-name="linkPage"/>
            </div>
            <div data-js="ConnectPhoneOpeningHours" data-selector=".s_connect_phone_opening_hours">
                <we-select string="Phone Number"
                           data-name="phone_number_opt"
                           data-attribute-name="numberId"/>
                <we-input string="Days Ahead"
                          data-select-data-attribute=""
                          data-attribute-name="days"
                          data-step="1"
                          data-min="1"
                          data-max="60"/>
                <we-checkbox string="Show Labels"
                             title="Display the names of public holidays and special working days"
                             data-select-data-attribute="false|true"
                             data-attribute-name="showLabels"/>
                <we-select string="Date Format" data-attribute-name="dateFormat">
                    <we-button data-select-data-attribute="long">Long (Saturday, 08.08.2026)</we-button>
                    <we-button data-select-data-attribute="short">Short (08.08.2026)</we-button>
                </we-select>
            </div>
        </xpath>
    </template>
</odoo>
