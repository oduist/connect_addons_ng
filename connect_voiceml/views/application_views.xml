<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_voiceml_application_tree" model="ir.ui.view">
        <field name="name">connect.voiceml.application.tree</field>
        <field name="model">connect.voiceml.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code_type"/>
                <field name="sid"/>
            </list>
        </field>
    </record>

    <record id="view_voiceml_application_form" model="ir.ui.view">
        <field name="name">connect.voiceml.application.form</field>
        <field name="model">connect.voiceml.application</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="code_type"/>
                            <field name="model" invisible="code_type != 'model_method'"/>
                            <field name="method" invisible="code_type != 'model_method'"/>
                        </group>
                        <group>
                            <field name="sid"/>
                        </group>
                    </group>
                    <group string="TwiML" invisible="code_type != 'twiml'">
                        <field name="twiml" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voiceml_application" model="ir.actions.act_window">
        <field name="name">TwiML Apps</field>
        <field name="res_model">connect.voiceml.application</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_voiceml_applications"
              name="TwiML Apps"
              parent="menu_connect_voiceml"
              action="action_voiceml_application"
              sequence="50"/>
</odoo>
