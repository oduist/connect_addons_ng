<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_voiceml_callflow_tree" model="ir.ui.view">
        <field name="name">connect.voiceml.callflow.tree</field>
        <field name="model">connect.voiceml.callflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exten_number"/>
                <field name="language"/>
            </list>
        </field>
    </record>

    <record id="view_voiceml_callflow_form" model="ir.ui.view">
        <field name="name">connect.voiceml.callflow.form</field>
        <field name="model">connect.voiceml.callflow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="language"/>
                        <field name="voice"/>
                        <field name="record_calls"/>
                        <field name="ring_users" widget="many2many_tags"/>
                    </group>
                    <group string="Gather">
                        <field name="gather_input"/>
                        <field name="gather_input_type" invisible="not gather_input"/>
                        <field name="gather_timeout" invisible="not gather_input"/>
                        <field name="gather_digits" invisible="not gather_input"/>
                        <field name="gather_hints" invisible="not gather_input"/>
                    </group>
                    <group string="Prompts">
                        <field name="prompt_message"/>
                        <field name="invalid_input_message"/>
                        <field name="voicemail_enabled"/>
                        <field name="voicemail_prompt" invisible="not voicemail_enabled"/>
                    </group>
                    <group string="Choices">
                        <field name="choices" nolabel="1">
                            <list>
                                <field name="choice_digits"/>
                                <field name="speech"/>
                                <field name="exten"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_voiceml_callflow" model="ir.actions.act_window">
        <field name="name">Call Flows</field>
        <field name="res_model">connect.voiceml.callflow</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_voiceml_callflows"
              name="Call Flows"
              parent="menu_connect_voiceml"
              action="action_voiceml_callflow"
              sequence="30"/>
</odoo>
