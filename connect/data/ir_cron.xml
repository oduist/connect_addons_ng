<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="vacuum_debug" model="ir.cron">
            <field name="name">Vacuum Connect debug</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_connect_debug"/>
            <field name="code">model.vacuum(hours=24)</field>
            <field name="state">code</field>
        </record>
        <record id="cron_transcribe_recordings" model="ir.cron">
            <field name="name">Connect: transcribe pending recordings</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="model_connect_recording"/>
            <field name="code">model._cron_transcribe_recordings()</field>
            <field name="state">code</field>
        </record>
    </data>
</odoo>
