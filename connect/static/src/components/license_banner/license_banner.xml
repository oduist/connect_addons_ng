<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="oduist.LicenseBanner">
        <div t-if="this.state.visible" t-att-class="this.bannerClass" t-on-click="this.openSettings">
            <i t-if="this.state.type === 'info'" class="fa fa-info-circle me-2"/>
            <i t-if="this.state.type === 'warning'" class="fa fa-exclamation-triangle me-2"/>
            <i t-if="this.state.type === 'danger'" class="fa fa-exclamation-circle me-2"/>
            <span t-esc="this.state.message"/>
        </div>
    </t>

</templates>
