<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_endpoint_tree" model="ir.ui.view">
        <field name="name">connect.endpoint.tree</field>
        <field name="model">connect.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="connect_user_id"/>
            </list>
        </field>
    </record>

    <record id="view_connect_endpoint_form" model="ir.ui.view">
        <field name="name">connect.endpoint.form</field>
        <field name="model">connect.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Endpoint Name"/>
                        </h1>
                        <label for="connect_user_id"/>
                        <h2>
                            <field name="connect_user_id" placeholder="Odoo Account"/>
                        </h2>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connect_endpoint_search" model="ir.ui.view">
        <field name="name">connect.endpoint.search</field>
        <field name="model">connect.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="connect_user_id"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_connect_endpoint" model="ir.actions.act_window">
        <field name="name">Endpoints</field>
        <field name="res_model">connect.endpoint</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_endpoints"
              name="Endpoints"
              parent="menu_connect_pbx"
              action="action_connect_endpoint"
              sequence="60"/>
</odoo>
