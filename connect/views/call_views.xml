<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_call_tree" model="ir.ui.view">
        <field name="name">connect.call.tree</field>
        <field name="model">connect.call</field>
        <field name="arch" type="xml">
            <tree default_order="id desc">
                <field name="direction"/>
                <field name="call_type" optional="hide"/>
                <field name="caller"/>
                <field name="called"/>
                <field name="partner"/>
                <field name="status"/>
                <field name="duration_human" string="Duration"/>
                <field name="recording_icon" string="Rec"/>
                <field name="voicemail_icon" string="VM"/>
                <field name="create_date" string="Date"/>
            </tree>
        </field>
    </record>

    <record id="view_connect_call_form" model="ir.ui.view">
        <field name="name">connect.call.form</field>
        <field name="model">connect.call</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <field name="status" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="create_partner_button" type="object"
                                class="oe_stat_button" icon="fa-user-plus"
                                string="Create Partner"
                   attrs="{'invisible': [('partner', '!=', False)]}"/>
                        <button name="transfer_button" type="object"
                                class="oe_stat_button" icon="fa-exchange"
                                string="Transfer"
                   attrs="{'invisible': [('status', '=', 'completed')]}"/>
                    </div>
                    <group>
                        <group string="Call Info">
                            <field name="direction"/>
                            <field name="call_type"/>
                            <field name="caller" widget="phone"/>
                            <field name="called" widget="phone"/>
                            <field name="partner"/>
                            <field name="duration_human" string="Duration"/>
                        </group>
                        <group string="Users">
                            <field name="caller_pbx_user"/>
                            <field name="answered_pbx_user"/>
                            <field name="caller_user"/>
                            <field name="answered_user"/>
                        </group>
                    </group>
                    <group string="Recording"
                   attrs="{'invisible': [('recording_widget', '=', False)]}">
                        <field name="recording_widget" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Voicemail"
                   attrs="{'invisible': [('voicemail_widget', '=', False)]}">
                        <field name="voicemail_widget" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Transcript"
                   attrs="{'invisible': [('transcript', '=', False)]}">
                        <field name="transcript" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Summary"
                   attrs="{'invisible': [('summary', '=', False)]}">
                        <field name="summary" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page name="channels" string="Channels">
                            <field name="channels">
                                <tree>
                                    <field name="caller"/>
                                    <field name="called"/>
                                    <field name="technical_direction" string="Direction"/>
                                    <field name="status"/>
                                    <field name="duration_human" string="Duration"/>
                                </tree>
                            </field>
                        </page>
                        <page name="error" string="Error"
                   attrs="{'invisible': [('has_error', '=', False)]}">
                            <group>
                                <field name="has_error"/>
                                <field name="error_code"/>
                                <field name="error_message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_connect_call" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">connect.call</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

    <menuitem id="menu_connect_calls_list"
              name="Calls"
              parent="menu_connect_calls"
              action="action_connect_call"
              sequence="10"/>
</odoo>
