<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_outgoing_callerid_tree" model="ir.ui.view">
        <field name="name">connect.outgoing_callerid.tree</field>
        <field name="model">connect.outgoing_callerid</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="friendly_name"/>
                <field name="status"/>
                <field name="callerid_type"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_connect_outgoing_callerid_form" model="ir.ui.view">
        <field name="name">connect.outgoing_callerid.form</field>
        <field name="model">connect.outgoing_callerid</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Caller ID">
                            <field name="number"/>
                            <field name="friendly_name"/>
                            <field name="callerid_type"/>
                            <field name="status" readonly="1"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Users">
                            <field name="callerid_users" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_connect_outgoing_callerid" model="ir.actions.act_window">
        <field name="name">Caller IDs</field>
        <field name="res_model">connect.outgoing_callerid</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_outgoing_callerid"
              name="Caller IDs"
              parent="menu_connect_pbx"
              action="action_connect_outgoing_callerid"
              sequence="30"/>
</odoo>
