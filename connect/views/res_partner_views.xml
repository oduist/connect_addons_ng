<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_connect_call_partner" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">connect.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('partner','=', active_id), ('partner.parent_id','=', active_id)]</field>
    </record>

    <record id="action_connect_message_partner" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">connect.message</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('partner','=', active_id), ('partner.parent_id','=', active_id)]</field>
    </record>

    <record id="view_partner_form_connect" model="ir.ui.view">
        <field name="name">res.partner.form.connect</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-phone"
                        invisible="connect_calls_count == 0"
                        type="action" name="%(action_connect_call_partner)d">
                    <field name="connect_calls_count" string="Calls" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" icon="fa-envelope"
                        invisible="connect_messages_count == 0"
                        type="action" name="%(action_connect_message_partner)d">
                    <field name="connect_messages_count" string="Messages" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
