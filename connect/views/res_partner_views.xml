<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_connect" model="ir.ui.view">
        <field name="name">res.partner.form.connect</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-phone"
                        invisible="connect_calls_count == 0"
                        type="action" name="%(action_connect_call)d"
                        domain="['|', ('partner', '=', id), ('partner.parent_id', '=', id)]"
                        context="{'search_default_filter_today': 0}">
                    <field name="connect_calls_count" string="Calls" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" icon="fa-envelope"
                        invisible="connect_messages_count == 0"
                        type="action" name="%(action_connect_message)d"
                        domain="['|', ('partner', '=', id), ('partner.parent_id', '=', id)]">
                    <field name="connect_messages_count" string="Messages" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
