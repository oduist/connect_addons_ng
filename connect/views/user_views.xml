<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_user_tree" model="ir.ui.view">
        <field name="name">connect.user.tree</field>
        <field name="model">connect.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="user"/>
                <field name="exten" optional="show"/>
                <field name="outgoing_callerid" optional="show"/>
                <field name="record_calls"/>
                <field name="voicemail_enabled"/>
                <field name="missed_calls_notify"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_connect_user_form" model="ir.ui.view">
        <field name="name">connect.user.form</field>
        <field name="model">connect.user</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_extension" type="object" string="Extension" class="btn btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <group>
                        <group string="User Info">
                            <field name="user"/>
                            <field name="exten" readonly="1"/>
                            <field name="outgoing_callerid"/>
                            <field name="active"/>
                        </group>
                        <group string="Call Settings">
                            <field name="record_calls"/>
                            <field name="voicemail_enabled"/>
                            <field name="missed_calls_notify"/>
                            <field name="greeting_message"/>
                            <field name="provider_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="organization" string="Organization">
                            <group string="Voicemail Prompt">
                                <field name="voicemail_prompt" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Summary Prompt">
                                <field name="summary_prompt" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page name="providers" string="Providers">
                            <field name="provider_binding_ids">
                                <list editable="bottom">
                                    <field name="provider_id"/>
                                    <field name="config" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_connect_user" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">connect.user</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_users"
              name="Users"
              parent="menu_connect_pbx"
              action="action_connect_user"
              sequence="10"/>
</odoo>
