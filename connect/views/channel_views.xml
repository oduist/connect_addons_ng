<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_channel_tree" model="ir.ui.view">
        <field name="name">connect.channel.tree</field>
        <field name="model">connect.channel</field>
        <field name="arch" type="xml">
            <list default_order="id desc">
                <field name="caller" widget="phone"/>
                <field name="called" widget="phone"/>
                <field name="technical_direction" string="Direction"/>
                <field name="status"/>
                <field name="duration_human" string="Duration"/>
                <field name="call_type"/>
                <field name="caller_pbx_user"/>
                <field name="called_pbx_user"/>
            </list>
        </field>
    </record>

    <record id="view_connect_channel_form" model="ir.ui.view">
        <field name="name">connect.channel.form</field>
        <field name="model">connect.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Channel Info">
                            <field name="call"/>
                            <field name="parent_channel"/>
                            <field name="parent_sid"/>
                            <field name="caller" widget="phone"/>
                            <field name="called" widget="phone"/>
                            <field name="to"/>
                            <field name="technical_direction" string="Direction"/>
                            <field name="status"/>
                            <field name="call_type"/>
                        </group>
                        <group string="Duration &amp; Users">
                            <field name="duration"/>
                            <field name="duration_human" string="Duration"/>
                            <field name="duration_minutes"/>
                            <field name="duration_billing"/>
                            <field name="partner"/>
                            <field name="caller_pbx_user"/>
                            <field name="called_pbx_user"/>
                            <field name="caller_user"/>
                            <field name="called_user"/>
                        </group>
                    </group>
                    <group>
                        <group string="Computed Numbers">
                            <field name="caller_number" widget="phone"/>
                            <field name="called_number" widget="phone"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_connect_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">connect.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_channels"
              name="Channels"
              parent="menu_connect_calls"
              action="action_connect_channel"
              groups="connect.group_admin"
              sequence="40"/>
</odoo>
