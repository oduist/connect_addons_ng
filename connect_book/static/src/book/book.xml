<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="connect_book.BookApp">
        <div class="o_connect_book d-flex h-100">
            <div class="o_connect_book_sidebar d-flex flex-column">
                <div class="o_connect_book_search p-2">
                    <input type="text" class="form-control form-control-sm" placeholder="Search the documentation…" t-att-value="this.state.search" t-on-input="this.onSearch"/>
                </div>
                <div class="o_connect_book_toc flex-grow-1 overflow-auto">
                    <t t-if="!this.state.loaded">
                        <div class="text-muted p-3">Loading…</div>
                    </t>
                    <t t-elif="this.filteredModules.length === 0">
                        <div class="text-muted p-3">No documentation found.</div>
                    </t>
                    <t t-foreach="this.filteredModules" t-as="mod" t-key="mod.id">
                        <div class="o_connect_book_module" t-esc="mod.title"/>
                        <t t-foreach="mod.pages" t-as="page" t-key="page.id">
                            <div class="o_connect_book_page_link" t-att-class="{ o_active: page.id === this.state.activeId }" t-on-click="() =&gt; this.selectPage(page.id)" t-esc="page.title"/>
                        </t>
                    </t>
                </div>
            </div>
            <div class="o_connect_book_content flex-grow-1 overflow-auto" t-ref="this.contentRef" t-on-click="this.onContentClick">
                <t t-if="this.activePage">
                    <div class="o_connect_book_doc" t-out="this.activePage.body"/>
                </t>
                <t t-else="">
                    <div class="o_connect_book_placeholder text-muted">
                        Select a page on the left to start reading.
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
