<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="connect_book.ChangelogApp">
        <div class="o_connect_book o_connect_book_changes d-flex h-100">
            <div class="o_connect_book_sidebar d-flex flex-column">
                <div class="o_connect_book_changes_title p-2">Changelog</div>
                <div class="o_connect_book_toc flex-grow-1 overflow-auto">
                    <t t-if="!state.loaded">
                        <div class="text-muted p-3">Loading…</div>
                    </t>
                    <t t-elif="state.sections.length === 0">
                        <div class="text-muted p-3">Nothing recorded yet.</div>
                    </t>
                    <t t-foreach="state.sections" t-as="section" t-key="section.id">
                        <div class="o_connect_book_page_link"
                             t-att-class="{ o_active: section.id === state.activeId }"
                             t-on-click="() => this.jumpTo(section.id)"
                             t-esc="section.title"/>
                    </t>
                </div>
            </div>
            <div class="o_connect_book_content flex-grow-1 overflow-auto" t-ref="content">
                <t t-if="state.loaded and !state.html">
                    <div class="o_connect_book_placeholder text-muted">
                        No changelog shipped with this installation.
                    </div>
                </t>
                <t t-else="">
                    <div class="o_connect_book_doc" t-out="body"/>
                </t>
            </div>
        </div>
    </t>
</templates>
