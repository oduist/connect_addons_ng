<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="elevenlabs_call_list" model="ir.ui.view">
        <field name="name">elevenlabs_call_list</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_tree"/>
        <field name="arch" type="xml">
            <field name="partner" position="after">
                <field name="elevenlabs_agent" optional="show"/>
            </field>
        </field>
    </record>

    <record id="elevenlabs_call_form" model="ir.ui.view">
        <field name="name">elevenlabs_call_form</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_form"/>
        <field name="arch" type="xml">
            <page name="channels" position="after">
                <page name="elevenlabs" string="Agent"
                      invisible="not elevenlabs_transcript and not elevenlabs_summary">
                    <group>
                        <group>
                            <field name="elevenlabs_recording_widget" nolabel="1"/>
                        </group>
                        <group>
                            <field name="elevenlabs_agent"/>
                        </group>
                    </group>
                    <group string="Agent Summary" invisible="not elevenlabs_summary">
                        <field name="elevenlabs_summary" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Transcript" invisible="not elevenlabs_transcript">
                        <field name="elevenlabs_transcript" nolabel="1" colspan="2"/>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
