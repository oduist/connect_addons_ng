<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="elevenlabs_number_list" model="ir.ui.view">
    <field name="name">elevenlabs_number_list</field>
    <field name="model">connect.twilio.number</field>
    <field name="inherit_id" ref="connect_twilio.view_twilio_number_tree"/>
    <field name="arch" type="xml">
      <field name="callflow" position="after">
        <field name="elevenlabs_agent"/>
      </field>
    </field>
  </record>

  <record id="elevenlabs_number_form" model="ir.ui.view">
    <field name="name">elevenlabs_number_form</field>
    <field name="model">connect.twilio.number</field>
    <field name="inherit_id" ref="connect_twilio.view_twilio_number_form"/>
    <field name="arch" type="xml">
      <field name="callflow" position="after">
        <field name="elevenlabs_agent"
               invisible="destination != 'elevenlabs_agent'"
               required="destination == 'elevenlabs_agent'"/>
      </field>
    </field>
  </record>

</odoo>
