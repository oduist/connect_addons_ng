<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="agent_action" model="ir.actions.act_window">
        <field name="name">Agents</field>
        <field name="res_model">connect.elevenlabs_agent</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="elevenlabs_agent_menu"
              sequence="60"
              parent="elevenlabs_menu"
              name="Agents"
              action="connect_elevenlabs.agent_action"/>

    <record id="connect_elevenlabs_agent_list" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_list</field>
        <field name="model">connect.elevenlabs_agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="llm"/>
                <field name="voice"/>
                <field name="language" optional="show"/>
                <field name="additional_languages" widget="many2many_tags" optional="show"/>
                <field name="exten_number" string="Exten"/>
            </list>
        </field>
    </record>

    <record id="connect_elevenlabs_agent_form" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_form</field>
        <field name="model">connect.elevenlabs_agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_extension" type="object" string="Extension" class="btn btn-primary"/>
                    <!-- <button name="transfer_test" type="object" string="Test" class="btn btn-primary"/> -->
                    <button name="print_config" type="object" string="Print" class="btn"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label class="oe_edit_only" for="name"/>
                            <field name="name" placeholder="Agent name..."/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="prompt" string="Prompt">
                            <group>
                                <field name="template" invisible="prompt"/>
                                <field name="active_prompt_version" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="first_message"/>
                                <field name="prompt" widget="text"/>
                            </group>

                        </page>
                        <page string="Conversation" name="conversation">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="voice"/>
                                    <field name="tools" widget="many2many_tags"/>
                                    <field name="has_transfer_tool" invisible="1"/>
                                    <field name="transfer_to_agent" invisible="not has_transfer_tool">
                                        <list>
                                            <field name="transfer_to_agent" string="Agent"/>
                                            <field name="condition"/>
                                        </list>
                                    </field>
                                </group>
                                <group>
                                    <field name="language"/>
                                    <field name="additional_languages" widget="many2many_tags"/>
                                    <field name="turn_timeout"/>
                                    <field name="silence_end_call_timeout"/>
                                    <field name="max_duration_seconds"/>
                                    <field name="agent_concurrency_limit"/>
                                    <field name="daily_limit"/>
                                    <field name="exten_number" string="Exten"/>
                                </group>
                            </group>
                        </page>
                        <page name="llm" string="LLM / TTS">
                            <group>
                                <group>
                                    <field name="llm"/>
                                    <field name="max_tokens"/>
                                </group>
                                <group>
                                    <field name="output_audio_format"/>
                                    <field name="user_input_audio_format"/>
                                    <field name="temperature" help="Temperature is a parameter that controls the creativity or randomness of the responses generated by the LLM."/>
                                    <field name="stability"/>
                                    <field name="speed"/>
                                    <field name="similarity_boost"/>
                                    <field name="model"/>
                                </group>
                            </group>
                        </page>
                        <page name="sip_trunk" string="SIP Trunk">
                            <group>
                                <group>
                                    <field name="sip_enabled"/>
                                    <div colspan="2" invisible="sip_enabled">
                                        <small>Enable to expose per-agent SIP trunk routing and credential override.</small>
                                    </div>
                                </group>
                            </group>
                            <group invisible="not sip_enabled">
                                <group string="Routing">
                                    <field name="sip_inbound_addresses"
                                           placeholder="sip:1.2.3.4:5060, sip:5.6.7.8"/>
                                    <field name="sip_outbound_addresses"
                                           placeholder="sip:trunk.example.com"/>
                                    <field name="sip_allowed_numbers"
                                           placeholder="+15551234567, +15557654321"/>
                                </group>
                                <group string="Credentials">
                                    <field name="sip_override_credentials"/>
                                    <field name="sip_username"
                                           invisible="not sip_override_credentials"/>
                                    <field name="sip_password" password="1"
                                           invisible="not sip_override_credentials"/>
                                    <div colspan="2" invisible="sip_override_credentials">
                                        <small>Using tenant defaults from <em>ElevenLabs Settings → SIP Trunk</em>.</small>
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page name="dev" string="Development" groups="base.group_no_one">
                            <group>
                                <group>
                                    <field name="agent_uid"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
