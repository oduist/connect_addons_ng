<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_endpoint_tree_asterisk" model="ir.ui.view">
        <field name="name">connect.endpoint.tree.asterisk</field>
        <field name="model">connect.endpoint</field>
        <field name="inherit_id" ref="connect.view_connect_endpoint_tree"/>
        <field name="arch" type="xml">
            <field name="connect_user_id" position="after">
                <field name="asterisk_channel" optional="show"/>
                <field name="asterisk_originate_enabled" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_connect_endpoint_form_asterisk" model="ir.ui.view">
        <field name="name">connect.endpoint.form.asterisk</field>
        <field name="model">connect.endpoint</field>
        <field name="inherit_id" ref="connect.view_connect_endpoint_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="after">
                <group string="Asterisk">
                    <field name="asterisk_channel" placeholder="PJSIP/101"/>
                    <field name="asterisk_sip_user"/>
                    <field name="asterisk_sip_transport"/>
                    <label for="asterisk_sip_password"
                           groups="connect.group_admin"/>
                    <div class="d-flex align-items-center"
                         groups="connect.group_admin">
                        <field name="asterisk_sip_password" password="True"
                               nolabel="1"/>
                        <button name="action_regenerate_asterisk_sip_password"
                                type="object"
                                string="Regenerate" class="btn-link ms-2"
                                icon="fa-refresh" invisible="not id"/>
                    </div>
                    <field name="asterisk_originate_enabled"
                           widget="boolean_toggle"/>
                    <field name="asterisk_originate_context"
                           invisible="not asterisk_originate_enabled"/>
                    <field name="asterisk_auto_answer_header"
                           invisible="not asterisk_originate_enabled"/>
                </group>
            </div>
        </field>
    </record>
</odoo>
