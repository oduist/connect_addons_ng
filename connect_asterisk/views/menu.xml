<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asterisk submenu of the Connect app. All provider submenus share
         the same sequence so they appear after Calls in installation order
         (equal sequence falls back to id order); the core Configuration menu
         (seq 100) always stays last. -->
    <menuitem id="menu_asterisk_root"
              name="Asterisk"
              parent="connect.menu_connect_root"
              sequence="50"/>

    <menuitem id="menu_asterisk_config"
              name="Configuration"
              parent="menu_asterisk_root"
              groups="connect.group_admin"
              sequence="100"/>
</odoo>
