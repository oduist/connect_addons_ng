<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_call_form_twilio" model="ir.ui.view">
        <field name="name">connect.call.form.twilio</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='channels']" position="after">
                <page name="twilio" string="Twilio">
                    <group>
                        <field name="call_sid"/>
                        <field name="price"/>
                        <field name="price_unit"/>
                        <field name="price_currency"/>
                        <field name="is_price_fetched"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
