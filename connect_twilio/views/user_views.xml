<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit core user list to add Twilio-specific columns -->
    <record id="view_connect_user_tree_twilio" model="ir.ui.view">
        <field name="name">connect.user.tree.twilio</field>
        <field name="model">connect.user</field>
        <field name="inherit_id" ref="connect.view_connect_user_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user']" position="after">
                <field name="username"/>
            </xpath>
            <xpath expr="//field[@name='outgoing_callerid']" position="after">
                <field name="sip_enabled" string="SIP"/>
                <field name="client_enabled" string="Web"/>
                <field name="application" optional="hide"/>
                <field name="domain" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit core user form to add Twilio-specific fields -->
    <record id="view_connect_user_form_twilio" model="ir.ui.view">
        <field name="name">connect.user.form.twilio</field>
        <field name="model">connect.user</field>
        <field name="inherit_id" ref="connect.view_connect_user_form"/>
        <field name="arch" type="xml">
            <!-- Visibility flag kept in an agnostic spot (after the
                 provider tags), outside the conditionally-hidden tab. -->
            <xpath expr="//field[@name='provider_ids']" position="after">
                <field name="is_twilio_enabled" invisible="1"/>
            </xpath>

            <!-- ADR-029: all Twilio-specific fields fenced into a single
                 named Twilio tab, shown only when the user is on Twilio.
                 Placed after Organization so the general tab leads. -->
            <xpath expr="//page[@name='organization']" position="after">
                <page name="twilio" string="Twilio" invisible="not is_twilio_enabled">
                    <group>
                        <group string="Account">
                            <field name="username" required="is_twilio_enabled"/>
                            <field name="domain" required="is_twilio_enabled"/>
                            <field name="twilio_edge"
                                   help="Choose the closest Twilio Edge or use Global Low-latency routing."/>
                        </group>
                        <group string="Messaging">
                            <field name="whatsapp_sender_id"/>
                            <field name="application"/>
                        </group>
                    </group>
                    <group>
                        <group string="SIP Phone">
                            <field name="sip_enabled" string="Enabled"/>
                            <field name="sip_priority" string="Priority"/>
                            <field name="password" password="1"
                                   invisible="sip_enabled == False"/>
                            <field name="sip_ring_timeout" string="Ring Timeout"
                                   invisible="sip_enabled == False"
                                   required="sip_enabled == True"/>
                            <field name="connect_uri" string="SIP URI"
                                   invisible="sip_enabled == False"/>
                        </group>
                        <group string="Web Phone">
                            <field name="client_enabled" string="Enabled"/>
                            <field name="client_priority" string="Priority"/>
                            <field name="client_ring_timeout" string="Ring Timeout"
                                   invisible="client_enabled == False"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
