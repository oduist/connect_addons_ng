<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_call_form_voicetel" model="ir.ui.view">
        <field name="name">connect.call.form.voicetel</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='channels']" position="after">
                <page name="voicetel" string="VoiceTel">
                    <group>
                        <field name="voicetel_call_sid"/>
                        <field name="voicetel_price"/>
                        <field name="voicetel_price_unit"/>
                        <field name="voicetel_is_price_fetched"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
