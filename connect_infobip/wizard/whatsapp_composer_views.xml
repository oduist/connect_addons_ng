<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_infobip_whatsapp_composer_form" model="ir.ui.view">
        <field name="name">connect.infobip.whatsapp_composer.form</field>
        <field name="model">connect.infobip.whatsapp_composer</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="whatsapp_sender_id"/>
                    <field name="phone"/>
                    <field name="template_id"/>
                    <field name="template_variables" invisible="not template_id"/>
                    <field name="body" readonly="template_id != False"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_send_whatsapp" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_infobip_whatsapp_composer" model="ir.actions.act_window">
        <field name="name">Send WhatsApp Message</field>
        <field name="res_model">connect.infobip.whatsapp_composer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
