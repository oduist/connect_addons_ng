<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_infobip_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">connect.infobip.whatsapp_template.tree</field>
        <field name="model">connect.infobip.whatsapp_template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sender_id"/>
                <field name="language"/>
                <field name="category"/>
                <field name="display_status" string="Status"/>
            </list>
        </field>
    </record>

    <record id="view_infobip_whatsapp_template_form" model="ir.ui.view">
        <field name="name">connect.infobip.whatsapp_template.form</field>
        <field name="model">connect.infobip.whatsapp_template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_in_infobip" string="Submit for Approval" type="object"
                            class="btn-primary" invisible="infobip_id != False"/>
                    <button name="action_sync" string="Sync" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="my_template_name"/></h1>
                    </div>
                    <group>
                        <group string="Template">
                            <field name="sender_id"/>
                            <field name="language"/>
                            <field name="category"/>
                            <field name="display_status" string="Status"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                        </group>
                        <group string="Identifiers">
                            <field name="infobip_id"/>
                        </group>
                    </group>
                    <group string="Body">
                        <field name="body" nolabel="1" colspan="2"
                               placeholder="Hello {{1}}, your order {{2}} is ready!"/>
                    </group>
                    <group string="Sample Variables (JSON)">
                        <field name="variables" nolabel="1" colspan="2"
                               placeholder='{"1": "John", "2": "SO0042"}'/>
                    </group>
                    <group string="Structure" invisible="not structure">
                        <field name="structure" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_infobip_whatsapp_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">connect.infobip.whatsapp_template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_infobip_whatsapp_templates"
              name="WhatsApp Templates"
              parent="menu_infobip_messages"
              action="action_infobip_whatsapp_template"
              groups="connect.group_admin"
              sequence="40"/>
</odoo>
