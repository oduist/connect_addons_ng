<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- connect.bird.number access rules -->
    <record id="access_bird_number_admin" model="ir.model.access">
        <field name="name">connect.bird.number admin</field>
        <field name="model_id" ref="model_connect_bird_number"/>
        <field name="group_id" ref="connect.group_admin"/>
        <field name="perm_read" eval="True"/>
