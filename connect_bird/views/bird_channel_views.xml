<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bird_channel_tree" model="ir.ui.view">
        <field name="name">connect.bird.channel.tree</field>
        <field name="model">connect.bird.channel</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="platform_id"/>
                <field name="identifier"/>
                <field name="status"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_bird_channel_form" model="ir.ui.view">
        <field name="name">connect.bird.channel.form</field>
        <field name="model">connect.bird.channel</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="platform_id"/>
                            <field name="identifier"/>
                        </group>
                        <group>
                            <field name="sid"/>
                            <field name="status"/>
                            <field name="is_default"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bird_channels" model="ir.actions.act_window">
        <field name="name">Bird Channels</field>
        <field name="res_model">connect.bird.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bird_channels"
              name="Channels"
              parent="menu_connect_bird"
              action="action_bird_channels"
              sequence="10"/>

</odoo>
