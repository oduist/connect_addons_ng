<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bird_message_template_tree" model="ir.ui.view">
        <field name="name">connect.bird.message_template.tree</field>
        <field name="model">connect.bird.message_template</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="product"/>
                <field name="category"/>
                <field name="locale"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_bird_message_template_form" model="ir.ui.view">
        <field name="name">connect.bird.message_template.form</field>
        <field name="model">connect.bird.message_template</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product"/>
                            <field name="category"/>
                            <field name="locale"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="sid"/>
                            <field name="scope"/>
                        </group>
                    </group>
                    <group string="Body Preview">
                        <field name="body_preview" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Variables">
                        <field name="variables" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bird_message_templates" model="ir.actions.act_window">
        <field name="name">Message Templates</field>
        <field name="res_model">connect.bird.message_template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bird_message_templates"
              name="Message Templates"
              parent="menu_bird_config"
              action="action_bird_message_templates"
              groups="connect.group_admin"
              sequence="20"/>

</odoo>
