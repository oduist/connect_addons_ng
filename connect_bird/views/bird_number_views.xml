<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bird_number_tree" model="ir.ui.view">
        <field name="name">connect.bird.number.tree</field>
        <field name="model">connect.bird.number</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="number"/>
                <field name="name"/>
                <field name="capabilities"/>
                <field name="status"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_bird_number_form" model="ir.ui.view">
        <field name="name">connect.bird.number.form</field>
        <field name="model">connect.bird.number</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="name"/>
                            <field name="capabilities"/>
                        </group>
                        <group>
                            <field name="sid"/>
                            <field name="status"/>
                            <field name="is_default"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bird_numbers" model="ir.actions.act_window">
        <field name="name">Bird Numbers</field>
        <field name="res_model">connect.bird.number</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bird_numbers"
              name="Numbers"
              parent="menu_connect_bird"
              action="action_bird_numbers"
              sequence="10"/>

</odoo>
