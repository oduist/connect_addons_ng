<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit core settings form to add Vonage-specific fields -->
    <record id="connect_settings_form_vonage" model="ir.ui.view">
        <field name="name">connect.settings.form.vonage</field>
        <field name="model">connect.settings</field>
        <field name="inherit_id" ref="connect.connect_settings_form"/>
        <field name="arch" type="xml">
            <!-- Add Balance group to General page -->
            <xpath expr="//page[@name='general']//group[1]" position="after">
                <group string="Balance">
                    <field name="vonage_balance" string="Current Balance" readonly="1"/>
                    <button class="btn btn-info" colspan="2" name="get_vonage_balance"
                            type="object" string="GET VONAGE BALANCE"/>
                </group>
            </xpath>

            <!-- Add Vonage API Keys page after General -->
            <xpath expr="//page[@name='general']" position="after">
                <page name="vonage_api" string="Vonage API">
                    <group>
                        <group string="Vonage Credentials" name="vonage_api">
                            <div colspan="2">
                                <small><strong>You can find your Vonage API data in
                                    <a href="https://dashboard.nexmo.com/" target="_blank">your Vonage Dashboard</a>
                                </strong></small>
                            </div>
                            <field name="vonage_auto_sync" groups="base.group_no_one"/>
                            <field name="vonage_api_key"/>
                            <field name="display_vonage_api_secret" string="API Secret" password="1"/>
                            <field name="display_vonage_signature_secret" string="Signature Secret" password="1"/>
                            <field name="vonage_region" string="Region"/>
                            <button colspan="2" name="sync" type="object"
                                    string="SYNC VONAGE ACCOUNT" class="btn btn-primary"/>
                        </group>
                        <group string="Vonage Application" name="vonage_application">
                            <div colspan="2">
                                <small>Leave empty to let the sync create a new
                                    application. To reuse an existing application,
                                    set its ID and paste its private key.</small>
                            </div>
                            <field name="vonage_application_id"/>
                            <field name="display_vonage_private_key" string="Private Key"
                                   placeholder="-----BEGIN PRIVATE KEY-----"/>
                        </group>
                    </group>
                </page>
                <page string="Development" groups="base.group_no_one" name="vonage_dev">
                    <group>
                        <group>
                            <field name="vonage_verify_requests"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
