<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_message_form_vonage" model="ir.ui.view">
        <field name="name">connect.message.form.vonage</field>
        <field name="model">connect.message</field>
        <field name="inherit_id" ref="connect.view_connect_message_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='message_sid']" position="attributes">
                <attribute name="string">Message UUID</attribute>
            </xpath>
        </field>
    </record>
</odoo>
