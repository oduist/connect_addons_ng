<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- connect.ncco access rules -->
    <record id="access_connect_ncco_admin" model="ir.access">
        <field name="name">connect.ncco admin</field>
        <field name="model_id" ref="model_connect_ncco"/>
        <field name="group_id" ref="connect.group_admin"/>
        <field name="operation">crud</field>
    </record>

    <record id="access_connect_ncco_user" model="ir.access">
        <field name="name">connect.ncco user</field>
        <field name="model_id" ref="model_connect_ncco"/>
        <field name="group_id" ref="connect.group_user"/>
        <field name="operation">r</field>
    </record>

    <record id="access_connect_ncco_webhook" model="ir.access">
        <field name="name">connect.ncco webhook</field>
        <field name="model_id" ref="model_connect_ncco"/>
        <field name="group_id" ref="connect.group_webhook"/>
        <field name="operation">r</field>
    </record>

</odoo>
