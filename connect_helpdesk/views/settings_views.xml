<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="connect_helpdesk_settings_form" model="ir.ui.view">
        <field name="name">connect_helpdesk.settings.form</field>
        <field name="model">connect.settings</field>
        <field name="inherit_id" ref="connect.connect_settings_form"/>
        <field name="arch" type="xml">
            <page name="transcription" position="after">
                <page name="helpdesk" string="Helpdesk">
                    <group>
                        <group string="Incoming Calls">
                            <field name="auto_create_tickets_for_in_calls" string="Auto Create Tickets"/>
                            <field name="auto_create_tickets_for_in_answered_calls" string="For Answered Calls"
                                   invisible="auto_create_tickets_for_in_calls == False"/>
                            <field name="auto_create_tickets_for_in_missed_calls" string="For Not Answered Calls"
                                   invisible="auto_create_tickets_for_in_calls == False"/>
                            <field name="auto_create_tickets_for_in_unknown_callers"
                                   invisible="auto_create_tickets_for_in_calls == False"/>
                        </group>
                        <group string="Outgoing Calls">
                            <field name="auto_create_tickets_for_out_calls" string="Auto Create Tickets"/>
                            <field name="auto_create_tickets_for_out_answered_calls" string="For Answered Calls"
                                   invisible="auto_create_tickets_for_out_calls == False"/>
                            <field name="auto_create_tickets_for_out_missed_calls" string="For Not Answered Calls"
                                   invisible="auto_create_tickets_for_out_calls == False"/>
                        </group>
                    </group>
                    <group string="Auto create options"
                           invisible="auto_create_tickets_for_in_calls == False and auto_create_tickets_for_out_calls == False">
                        <group>
                            <field name="auto_create_tickets_team"/>
                            <field name="auto_create_tickets_user"
                                   help="Assigned when no PBX user maps to the call."/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
