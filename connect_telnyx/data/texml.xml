<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="domain_route_call" model="connect.telnyx.texml">
            <field name="name">SIP Domain Calls</field>
            <field name="code_type">model_method</field>
            <field name="model">connect.telnyx.domain</field>
            <field name="method">route_call</field>
            <field name="description">This is a special app that is responsible for incoming SIP/Client calls</field>
        </record>

        <record id="texml_reject" model="connect.telnyx.texml">
            <field name="name">Reject</field>
            <field name="code_type">texml</field>
            <field name="texml">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;Response&gt;
    &lt;Reject /&gt;
&lt;/Response&gt;</field>
        </record>

        <record id="texml_connection_failed" model="connect.telnyx.texml">
            <field name="name">Connection Failed</field>
            <field name="code_type">texml</field>
            <field name="texml">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;Response&gt;
    &lt;Say&gt;Sorry, I could not connect your call. Goodbye!&lt;/Say&gt;
&lt;/Response&gt;</field>
        </record>
    </data>
</odoo>
