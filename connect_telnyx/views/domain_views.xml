<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="domain_action" model="ir.actions.act_window">
        <field name="name">Domains</field>
        <field name="res_model">connect.telnyx.domain</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_domains"
              sequence="60"
              parent="menu_connect_telnyx"
              name="SIP Domains"
              action="domain_action"/>

    <record id="view_connect_telnyx_domain_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.domain.tree</field>
        <field name="model">connect.telnyx.domain</field>
        <field name="arch" type="xml">
            <list>
                <field name="friendly_name"/>
                <field name="domain_name"/>
                <field name="delete_protection"/>
            </list>
        </field>
    </record>

    <record id="view_connect_telnyx_domain_form" model="ir.ui.view">
        <field name="name">connect.telnyx.domain.form</field>
        <field name="model">connect.telnyx.domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label class="oe_edit_only" for="friendly_name"/>
                            <field name="friendly_name" placeholder="Friendly name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="subdomain"/>
                            <field name="application"/>
                        </group>
                        <group>
                            <field name="delete_protection"/>
                            <field name="domain_name" string="SIP Hostname"
                                   help="Web phone calls are routed by Odoo through this SIP subdomain of the TeXML application."/>
                            <field name="connection_username"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
