<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_message_configuration_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.message_configuration.tree</field>
        <field name="model">connect.telnyx.message_configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="destination"/>
            </list>
        </field>
    </record>

    <record id="view_telnyx_message_configuration_form" model="ir.ui.view">
        <field name="name">connect.telnyx.message_configuration.form</field>
        <field name="model">connect.telnyx.message_configuration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="destination"/>
                        </group>
                    </group>
                    <group string="Default Values">
                        <field name="default_values" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telnyx_message_configuration" model="ir.actions.act_window">
        <field name="name">Message Configuration</field>
        <field name="res_model">connect.telnyx.message_configuration</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_telnyx_message_configuration"
              name="Message Configuration"
              parent="menu_telnyx_messages"
              action="action_telnyx_message_configuration"
              groups="connect.group_admin"
              sequence="20"/>
</odoo>
