<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_rcs_agent_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.rcs_agent.tree</field>
        <field name="model">connect.telnyx.rcs_agent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="agent_name"/>
                <field name="agent_id"/>
                <field name="enabled"/>
                <field name="is_default"/>
            </tree>
        </field>
    </record>

    <record id="view_telnyx_rcs_agent_form" model="ir.ui.view">
        <field name="name">connect.telnyx.rcs_agent.form</field>
        <field name="model">connect.telnyx.rcs_agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync" string="Sync" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="agent_name" placeholder="Agent name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="enabled"/>
                        </group>
                        <group>
                            <field name="profile_id"/>
                            <field name="is_default"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telnyx_rcs_agent" model="ir.actions.act_window">
        <field name="name">RCS Agents</field>
        <field name="res_model">connect.telnyx.rcs_agent</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_telnyx_rcs_agents"
              name="RCS Agents"
              parent="menu_telnyx_messages"
              action="action_telnyx_rcs_agent"
              groups="connect.group_admin"
              sequence="50"/>
</odoo>
