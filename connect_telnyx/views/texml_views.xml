<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="texml_action" model="ir.actions.act_window">
        <field name="name">TeXML</field>
        <field name="res_model">connect.telnyx.texml</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_texml"
              sequence="50"
              parent="menu_connect_telnyx"
              name="TeXML Apps"
              action="texml_action"/>

    <record id="view_connect_texml_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.texml.tree</field>
        <field name="model">connect.telnyx.texml</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exten"/>
                <field name="description"/>
                <field name="code_type"/>
            </list>
        </field>
    </record>

    <record id="view_connect_texml_form" model="ir.ui.view">
        <field name="name">connect.telnyx.texml.form</field>
        <field name="model">connect.telnyx.texml</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_extension" type="object" string="Extension" class="btn btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <label class="oe_edit_only" for="name"/>
                            <field name="name" placeholder="TeXML name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="code_type"/>
                        </group>
                        <group>
                            <field name="exten_number"/>
                        </group>
                    </group>
                    <group>
                        <field name="texpy" widget="ace" options="{'mode': 'python'}"
                               invisible="code_type != 'texpy'"
                               required="code_type == 'texpy'"/>
                        <field name="model"
                               invisible="code_type != 'model_method'"
                               required="code_type == 'model_method'"/>
                        <field name="method"
                               invisible="code_type != 'model_method'"
                               required="code_type == 'model_method'"/>
                        <field name="texml" widget="ace"
                               invisible="code_type != 'texml'" readonly="code_type == 'texpy'"
                               required="code_type == 'texml'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connect_texml_search" model="ir.ui.view">
        <field name="name">connect.telnyx.texml.search</field>
        <field name="model">connect.telnyx.texml</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="exten_number"/>
                <field name="texml"/>
                <field name="texpy"/>
                <field name="code_type"/>
                <filter name="by_type" context="{'group_by': 'code_type'}"/>
            </search>
        </field>
    </record>

</odoo>
