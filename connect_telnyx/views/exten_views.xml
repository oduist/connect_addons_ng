<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_exten_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.exten.tree</field>
        <field name="model">connect.telnyx.exten</field>
        <field name="arch" type="xml">
            <tree>
                <field name="number"/>
                <field name="dst"/>
                <field name="model_friendly" string="Type"/>
            </tree>
        </field>
    </record>

    <record id="view_telnyx_exten_form" model="ir.ui.view">
        <field name="name">connect.telnyx.exten.form</field>
        <field name="model">connect.telnyx.exten</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="dst"/>
                            <field name="model_friendly" string="Type" readonly="1"/>
                        </group>
                    </group>
                    <group string="Dialplan Preview"
                   attrs="{'invisible': [('dialplan', '=', False)]}">
                        <field name="dialplan" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telnyx_exten" model="ir.actions.act_window">
        <field name="name">Extensions</field>
        <field name="res_model">connect.telnyx.exten</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_telnyx_extens"
              name="Extensions"
              parent="menu_connect_telnyx"
              action="action_telnyx_exten"
              sequence="20"/>
</odoo>
