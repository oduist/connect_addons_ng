<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_outgoing_callerid_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.outgoing_callerid.tree</field>
        <field name="model">connect.telnyx.outgoing_callerid</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="friendly_name"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_telnyx_outgoing_callerid_form" model="ir.ui.view">
        <field name="name">connect.telnyx.outgoing_callerid.form</field>
        <field name="model">connect.telnyx.outgoing_callerid</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Caller ID">
                            <field name="number"/>
                            <field name="friendly_name"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Users">
                            <field name="callerid_users" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telnyx_callerid" model="ir.actions.act_window">
        <field name="name">Outgoing Caller IDs</field>
        <field name="res_model">connect.telnyx.outgoing_callerid</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_telnyx_callerids"
              name="Outgoing Caller IDs"
              parent="menu_connect_telnyx"
              action="action_telnyx_callerid"
              sequence="40"/>
</odoo>
