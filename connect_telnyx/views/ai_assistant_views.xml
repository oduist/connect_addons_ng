<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_ai_assistant_list" model="ir.ui.view">
        <field name="name">connect.telnyx.ai_assistant.list</field>
        <field name="model">connect.telnyx.ai_assistant</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="receptionist_mode"/>
                <field name="exten_number" string="Extension"/>
                <field name="model"/>
                <field name="voice_label" string="Voice"/>
                <field name="record_calls"/>
                <field name="memory_enabled"/>
                <field name="sid"/>
                <field name="last_sync_at"/>
            </tree>
        </field>
    </record>

    <record id="view_telnyx_ai_assistant_form" model="ir.ui.view">
        <field name="name">connect.telnyx.ai_assistant.form</field>
        <field name="model">connect.telnyx.ai_assistant</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_call_with_assistant" type="object"
                            string="Call with Assistant" class="btn-primary"
                   attrs="{'invisible': [('sid', '=', False)]}"/>
                    <button name="action_push_to_telnyx" type="object"
                            string="Push to Telnyx"/>
                    <button name="create_extension" type="object"
                            string="Create Extension"/>
                    <button name="action_rotate_tool_token" type="object"
                            string="Rotate Tool Token"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Assistant name..."/></h1>
                    </div>
                    <group>
                        <group string="Telnyx">
                            <field name="sid"/>
                            <field name="version_id"/>
                            <field name="last_sync_at"/>
                            <field name="active"/>
                        </group>
                        <group string="Model and Voice">
                            <field name="model"/>
                            <field name="voice_is_expressive" invisible="1"/>
                            <field name="voice_language"/>
                            <field name="voice_provider"/>
                            <field name="voice" widget="telnyx_voice"
                                   options="{'language_field': 'voice_language',
                                             'provider_field': 'voice_provider',
                                             'speed_field': 'voice_speed',
                                             'text_field': 'greeting'}"/>
                            <field name="voice_speed"/>
                            <field name="language_boost"/>
                            <field name="expressive_mode"
                   attrs="{'invisible': [('voice_is_expressive', '=', False)]}"/>
                            <field name="language_mode"/>
                            <field name="default_lang" required="1"/>
                            <field name="transcription_model"/>
                            <field name="transcription_language"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agent" name="agent">
                            <group>
                                <field name="description"/>
                                <field name="greeting"/>
                                <field name="instructions"/>
                            </group>
                        </page>
                        <page string="Calling" name="calling">
                            <group>
                                <group string="Receptionist">
                                    <field name="receptionist_mode"/>
                                    <field name="transfer_enabled"/>
                                    <field name="manager"
                   attrs="{'invisible': [('receptionist_mode', '!=', 'personal')], 'required': [('transfer_enabled', '!=', False), ('receptionist_mode', '=', 'personal')]}"/>
                                    <field name="transfer_callflows" widget="many2many_tags"
                   attrs="{'invisible': [('receptionist_mode', '!=', 'company')], 'required': [('transfer_enabled', '!=', False), ('receptionist_mode', '=', 'company')]}"/>
                                    <field name="check_registration_before_transfer"
                   attrs="{'invisible': [('transfer_enabled', '=', False)]}"/>
                                    <field name="warm_transfer_instructions"
                   attrs="{'invisible': [('transfer_enabled', '=', False)]}"/>
                                    <field name="warm_transfer_message_delay_ms"
                   attrs="{'invisible': [('transfer_enabled', '=', False)]}"/>
                                </group>
                                <group string="SIP / WebRTC Extension">
                                    <field name="domain"/>
                                    <field name="exten" readonly="1"/>
                                    <field name="exten_number" readonly="1"/>
                                    <field name="sip_uri" readonly="1"/>
                                    <field name="transfer_tool_sid" readonly="1"
                                           groups="connect.group_admin"/>
                                </group>
                            </group>
                            <group string="Call Settings">
                                <field name="time_limit_secs"/>
                                <field name="user_idle_timeout_secs"/>
                                <field name="record_calls"/>
                                <field name="memory_enabled"/>
                            </group>
                            <group string="Turn Taking">
                                <field name="allow_interruptions"/>
                                <field name="protect_greeting"/>
                                <field name="start_speaking_wait_secs"/>
                                <field name="endpointing_no_punctuation_secs"/>
                                <field name="endpointing_punctuation_secs"/>
                                <field name="endpointing_number_secs"/>
                            </group>
                        </page>
                        <page string="Odoo Tools" name="odoo_tools">
                            <group>
                                <field name="enable_contact_tools"/>
                                <field name="enable_crm_tools"
                                       help="Published only when Connect CRM is installed."/>
                                <field name="enable_helpdesk_tools"
                                       help="Published only when Connect Helpdesk is installed."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telnyx_ai_assistant" model="ir.actions.act_window">
        <field name="name">AI Assistants</field>
        <field name="res_model">connect.telnyx.ai_assistant</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_telnyx_ai_assistants"
              name="AI Assistants"
              parent="menu_connect_telnyx"
              action="action_telnyx_ai_assistant"
              groups="connect.group_admin"
              sequence="20"/>
</odoo>
