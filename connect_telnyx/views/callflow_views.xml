<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_callflow_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.callflow.tree</field>
        <field name="model">connect.telnyx.callflow</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="exten_number" string="Extension"/>
            </tree>
        </field>
    </record>

    <record id="view_telnyx_callflow_form" model="ir.ui.view">
        <field name="name">connect.telnyx.callflow.form</field>
        <field name="model">connect.telnyx.callflow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="create_extension" type="object"
                                class="oe_stat_button" icon="fa-phone"
                                string="Extension"/>
                    </div>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="exten" readonly="1"/>
                            <field name="exten_number" readonly="1"/>
                            <field name="language"/>
                            <field name="voice"/>
                            <field name="record_calls"/>
                            <field name="gather_input"/>
                        </group>
                        <group string="Voicemail">
                            <field name="voicemail_enabled"/>
                            <field name="voicemail_prompt"
                   attrs="{'invisible': [('voicemail_enabled', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Gather Settings"
                   attrs="{'invisible': [('gather_input', '=', False)]}">
                        <group>
                            <field name="gather_input_type"/>
                            <field name="gather_timeout"/>
                            <field name="gather_digits"/>
                            <field name="gather_hints"
                   attrs="{'invisible': [('gather_input_type', '=', 'dtmf')]}"/>
                        </group>
                    </group>
                    <group
                   attrs="{'invisible': [('gather_input', '=', False)]}">
                        <group string="Prompt Message">
                            <field name="prompt_message" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Invalid Input Message">
                            <field name="invalid_input_message" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="choices" string="Choices"
                   attrs="{'invisible': [('gather_input', '=', False)]}">
                            <field name="choices">
                                <tree editable="bottom">
                                    <field name="choice_digits"/>
                                    <field name="exten"/>
                                    <field name="speech"/>
                                </tree>
                            </field>
                        </page>
                        <page name="ring_users" string="Ring Users">
                            <field name="ring_users">
                                <tree>
                                    <field name="user"/>
                                    <field name="telnyx_exten"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telnyx_callflow" model="ir.actions.act_window">
        <field name="name">Call Flows</field>
        <field name="res_model">connect.telnyx.callflow</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_telnyx_callflows"
              name="Call Flows"
              parent="menu_connect_telnyx"
              action="action_telnyx_callflow"
              sequence="30"/>
</odoo>
