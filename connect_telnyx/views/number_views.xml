<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telnyx_number_tree" model="ir.ui.view">
        <field name="name">connect.telnyx.number.tree</field>
        <field name="model">connect.telnyx.number</field>
        <field name="arch" type="xml">
            <tree>
                <field name="phone_number"/>
                <field name="friendly_name"/>
                <field name="destination"/>
                <field name="user"/>
                <field name="callflow"/>
                <field name="texml"/>
                <field name="ai_assistant"/>
                <field name="is_ignored"/>
            </tree>
        </field>
    </record>

    <record id="view_telnyx_number_form" model="ir.ui.view">
        <field name="name">connect.telnyx.number.form</field>
        <field name="model">connect.telnyx.number</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Number">
                            <field name="phone_number"/>
                            <field name="friendly_name"/>
                            <field name="is_ignored"/>
                        </group>
                        <group string="Routing">
                            <field name="destination"/>
                            <field name="user"
                   attrs="{'invisible': [('destination', '!=', 'user')]}"/>
                            <field name="callflow"
                   attrs="{'invisible': [('destination', '!=', 'callflow')]}"/>
                            <field name="texml"
                   attrs="{'invisible': [('destination', '!=', 'texml')], 'required': [('destination', '=', 'texml')]}"/>
                            <field name="ai_assistant"
                   attrs="{'invisible': [('destination', '!=', 'ai_assistant')], 'required': [('destination', '=', 'ai_assistant')]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telnyx_number" model="ir.actions.act_window">
        <field name="name">Numbers</field>
        <field name="res_model">connect.telnyx.number</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_telnyx_numbers"
              name="Numbers"
              parent="menu_connect_telnyx"
              action="action_telnyx_number"
              sequence="10"/>
</odoo>
