<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="connect_telnyx.TelnyxVoiceField">
        <t t-if="this.props.readonly">
            <span t-esc="this.state.displayValue"/>
        </t>
        <t t-else="">
            <div class="d-flex align-items-center gap-1 w-100">
                <AutoComplete t-key="this.state.revision" value="this.state.displayValue" id="this.props.id" placeholder="this.placeholder" sources="this.sources" autoSelect="false" class="'flex-grow-1'" onBlur.bind="this.resetUnselectedInput"/>
                <button type="button" class="btn btn-link p-1 o_telnyx_voice_play" t-if="this.rawValue" t-att-disabled="this.state.playing" title="Play a sample of this voice" t-on-click="() =&gt; this.playSample()">
                    <i t-att-class="this.state.playing ? 'fa fa-spinner fa-spin' : 'fa fa-volume-up'"/>
                </button>
            </div>
        </t>
    </t>

</templates>
