<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dograh_agent_tree" model="ir.ui.view">
        <field name="name">connect.dograh.agent.tree</field>
        <field name="model">connect.dograh.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exten_number"/>
                <field name="workflow_id"/>
                <field name="record_calls"/>
            </list>
        </field>
    </record>

    <record id="view_dograh_agent_form" model="ir.ui.view">
        <field name="name">connect.dograh.agent.form</field>
        <field name="model">connect.dograh.agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_extension" type="object"
                            string="Create Extension"
                            class="btn btn-primary" invisible="exten"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Agent Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="exten" readonly="1"/>
                            <field name="workflow_id"/>
                            <field name="record_calls"/>
                        </group>
                        <group>
                            <div colspan="2">
                                <small>Calls to this extension are routed to
                                Dograh. Assign the extension number to an
                                inbound workflow on the Dograh Phone Numbers
                                page — the number entered there must match
                                this extension.</small>
                            </div>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dograh_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">connect.dograh.agent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Dograh AI agent
            </p>
            <p>
                An agent links a FreeSWITCH extension to a Dograh voice
                workflow. Build the workflow in Dograh, then create an
                agent here and its extension to make it callable.
            </p>
        </field>
    </record>

    <menuitem id="menu_dograh_agents"
              name="AI Agents"
              parent="menu_connect_dograh"
              action="action_dograh_agent"
              sequence="10"/>
</odoo>
