<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dograh submenu of the Connect app. All provider submenus share the
         same sequence so they appear after Calls in installation order
         (equal sequence falls back to id order); the core Configuration
         menu (seq 100) always stays last. -->
    <menuitem id="menu_connect_dograh"
              name="Dograh"
              parent="connect.menu_connect_root"
              sequence="50"/>

    <menuitem id="menu_dograh_config"
              name="Configuration"
              parent="menu_connect_dograh"
              groups="connect.group_admin"
              sequence="100"/>
</odoo>
