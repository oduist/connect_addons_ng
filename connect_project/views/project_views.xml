<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="connect_calls_project_action" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">connect.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('project', '=', active_id)]</field>
    </record>

    <record id="edit_project_connect_project" model="ir.ui.view">
        <field name="name">connect_project.project.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(connect_calls_project_action)d" type="action"
                        class="oe_stat_button" icon="fa-phone"
                        groups="connect.group_user">
                    <field name="connect_calls_count" string="Calls" widget="statinfo"/>
                </button>
            </xpath>
            <field name="partner_id" position="after">
                <field name="partner_phone" readonly="1"/>
                <field name="partner_mobile" readonly="1"/>
            </field>
            <notebook position="inside">
                <page name="recorded_calls" string="Recorded Calls">
                    <field name="recorded_calls">
                        <list>
                            <field name="start_time"/>
                            <field name="caller_number"/>
                            <field name="called_number"/>
                            <field name="recording_widget" widget="html"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
