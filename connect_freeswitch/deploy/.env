COMPOSE_PROJECT_NAME=fs
ODOO_URL=http://localhost:8069

# Public FQDN of this FreeSWITCH host. Traefik requests a Let's Encrypt
# certificate for it, and the fs entrypoint reuses that cert for Verto/WSS.
# Must be a real public domain resolving to this host for ACME to succeed.
FS_DOMAIN=localhost

# Email used for Let's Encrypt registration and expiry notices.
ACME_EMAIL=admin@example.com

# Let's Encrypt CA. Unset means production. Uncomment the staging URL while
# testing so failed validations don't burn the production rate limit:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
