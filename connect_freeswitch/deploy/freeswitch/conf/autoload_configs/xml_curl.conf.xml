<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <!-- Every binding authenticates against Odoo with the shared webhook
       token (Basic auth, password part). See ADR-025. -->
  <bindings>
    <binding name="odoo-directory">
      <param name="gateway-url" value="$${odoo_url}/freeswitch/xml" bindings="directory"/>
      <param name="auth-scheme" value="basic"/>
      <param name="gateway-credentials" value="freeswitch:$${webhook_token}"/>
      <param name="timeout" value="10"/>
    </binding>
    <binding name="odoo-dialplan">
      <param name="gateway-url" value="$${odoo_url}/freeswitch/xml"/>
      <param name="bindings" value="dialplan"/>
      <param name="auth-scheme" value="basic"/>
      <param name="gateway-credentials" value="freeswitch:$${webhook_token}"/>
    </binding>
    <binding name="odoo-configuration">
      <param name="gateway-url" value="$${odoo_url}/freeswitch/xml"/>
      <param name="bindings" value="configuration"/>
      <param name="auth-scheme" value="basic"/>
      <param name="gateway-credentials" value="freeswitch:$${webhook_token}"/>
    </binding>
  </bindings>
</configuration>
