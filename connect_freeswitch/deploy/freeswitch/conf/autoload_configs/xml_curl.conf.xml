<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <binding name="odoo-directory">
      <!-- URL Odoo для получения XML конфигурации -->
      <param name="gateway-url" value="http://localhost:8069/freeswitch/xml" bindings="directory"/>
      <param name="timeout" value="10"/>
    </binding>
    <binding name="odoo-dialplan">
      <param name="gateway-url" value="http://localhost:8069/freeswitch/xml" formula="exten=$${destination_number}"/>
      <param name="bindings" value="dialplan"/>
    </binding>
  </bindings>
</configuration>
