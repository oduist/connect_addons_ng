 static abyss_bool HTTPWrite(TSession * s, const char *buffer, const uint32_t len);
 
+#ifndef _WIN32
+static int create_loopback_socket(uint16_t port)
+{
+	int server_socket;
+	int reuse = 1;
+	struct sockaddr_in address;
+
+	server_socket = socket(AF_INET, SOCK_STREAM, 0);
+	if (server_socket < 0) {
+		switch_log_printf(SWITCH_CHANNEL_LOG, SWITCH_LOG_ERROR,
+					  "Cannot create XML-RPC loopback socket: %s\n", strerror(errno));
+		return -1;
+	}
+
+	if (setsockopt(server_socket, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse)) < 0) {
+		switch_log_printf(SWITCH_CHANNEL_LOG, SWITCH_LOG_WARNING,
+					  "Cannot set SO_REUSEADDR on XML-RPC socket: %s\n", strerror(errno));
+	}
+
+	memset(&address, 0, sizeof(address));
+	address.sin_family = AF_INET;
+	address.sin_port = htons(port);
+	address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+	if (bind(server_socket, (struct sockaddr *)&address, sizeof(address)) < 0) {
+		switch_log_printf(SWITCH_CHANNEL_LOG, SWITCH_LOG_ERROR,
+					  "Cannot bind XML-RPC to 127.0.0.1:%u: %s\n",
+					  port, strerror(errno));
+		close(server_socket);
+		return -1;
+	}
+
+	return server_socket;
+}
+#endif
