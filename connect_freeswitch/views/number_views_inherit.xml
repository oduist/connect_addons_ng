<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_connect_number_form_fs_fifo" model="ir.ui.view">
        <field name="name">connect.number.form.fs_fifo</field>
        <field name="model">connect.number</field>
        <field name="inherit_id" ref="connect.view_connect_number_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='callflow']" position="after">
                <field name="fs_fifo_id"
                       invisible="destination != 'fs_fifo'"
                       required="destination == 'fs_fifo'"/>
            </xpath>
        </field>
    </record>

    <record id="view_connect_number_tree_fs_fifo" model="ir.ui.view">
        <field name="name">connect.number.tree.fs_fifo</field>
        <field name="model">connect.number</field>
        <field name="inherit_id" ref="connect.view_connect_number_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='callflow']" position="after">
                <field name="fs_fifo_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
