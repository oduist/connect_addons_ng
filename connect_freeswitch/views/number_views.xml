<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freeswitch_number_tree" model="ir.ui.view">
        <field name="name">connect.freeswitch.number.tree</field>
        <field name="model">connect.freeswitch.number</field>
        <field name="arch" type="xml">
            <list>
                <field name="phone_number"/>
                <field name="friendly_name"/>
                <field name="destination"/>
                <field name="user"/>
                <field name="callflow"/>
                <field name="fs_fifo_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_freeswitch_number_form" model="ir.ui.view">
        <field name="name">connect.freeswitch.number.form</field>
        <field name="model">connect.freeswitch.number</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Number">
                            <field name="phone_number"/>
                            <field name="friendly_name"/>
                            <field name="is_default"/>
                        </group>
                        <group string="Routing">
                            <field name="destination"/>
                            <field name="user" invisible="destination != 'user'"/>
                            <field name="callflow" invisible="destination != 'callflow'"/>
                            <field name="fs_fifo_id"
                                   invisible="destination != 'fs_fifo'"
                                   required="destination == 'fs_fifo'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freeswitch_number" model="ir.actions.act_window">
        <field name="name">Numbers</field>
        <field name="res_model">connect.freeswitch.number</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_freeswitch_numbers"
              name="Numbers"
              parent="menu_freeswitch_root"
              action="action_freeswitch_number"
              sequence="10"/>
</odoo>
