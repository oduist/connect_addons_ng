<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freeswitch_number_tree" model="ir.ui.view">
        <field name="name">connect.freeswitch.number.tree</field>
        <field name="model">connect.freeswitch.number</field>
        <field name="arch" type="xml">
            <list>
                <field name="phone_number"/>
                <field name="friendly_name"/>
                <field name="destination"/>
                <field name="user"/>
                <field name="callflow"/>
                <field name="fs_fifo_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_freeswitch_number_form" model="ir.ui.view">
        <field name="name">connect.freeswitch.number.form</field>
        <field name="model">connect.freeswitch.number</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_schedule_slots" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                string="Availability"
                                invisible="not schedule_enabled or not schedule_id"/>
                    </div>
                    <group>
                        <group string="Number">
                            <field name="phone_number"/>
                            <field name="friendly_name"/>
                        </group>
                        <group string="Routing">
                            <field name="destination"
                                   string="Destination (Available)"/>
                            <field name="user" invisible="destination != 'user'"/>
                            <field name="callflow" invisible="destination != 'callflow'"/>
                            <field name="fs_fifo_id"
                                   invisible="destination != 'fs_fifo'"
                                   required="destination == 'fs_fifo'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Working Schedule">
                            <field name="schedule_enabled"/>
                            <field name="schedule_id"
                                   invisible="not schedule_enabled"
                                   required="schedule_enabled"/>
                            <field name="schedule_prompt_language"
                                   invisible="not schedule_enabled"/>
                        </group>
                        <group string="After-hours Routing"
                               invisible="not schedule_enabled">
                            <field name="closed_destination"/>
                            <field name="closed_user"
                                   invisible="closed_destination != 'user'"/>
                            <field name="closed_callflow"
                                   invisible="closed_destination != 'callflow'"/>
                            <field name="closed_fs_fifo_id"
                                   invisible="closed_destination != 'fs_fifo'"
                                   required="closed_destination == 'fs_fifo'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freeswitch_number" model="ir.actions.act_window">
        <field name="name">Numbers</field>
        <field name="res_model">connect.freeswitch.number</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_freeswitch_numbers"
              name="Numbers"
              parent="menu_freeswitch_root"
              action="action_freeswitch_number"
              sequence="10"/>
</odoo>
