<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="connect_settings_form_freeswitch" model="ir.ui.view">
        <field name="name">connect.settings.form.freeswitch</field>
        <field name="model">connect.settings</field>
        <field name="inherit_id" ref="connect.connect_settings_form"/>
        <field name="arch" type="xml">
            <page name="general" position="after">
                <page name="freeswitch" string="FreeSWITCH">
                    <group>
                        <group string="Status">
                            <field name="freeswitch_status"/>
                            <field name="freeswitch_uptime"/>
                            <field name="freeswitch_calls"/>
                            <field name="freeswitch_registrations"/>
                            <button name="check_freeswitch_status" type="object"
                                    string="CHECK STATUS" class="btn btn-info"
                                    colspan="2"/>
                        </group>
                        <group string="Gateway Status">
                            <field name="freeswitch_gateway_statuses"
                                   nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <group>
                        <group string="Connection">
                            <field name="freeswitch_socket_url"
                                   placeholder="wss://your-fs-domain:8082"/>
                            <field name="freeswitch_domain"
                                   placeholder="fs.example.com"/>
                            <field name="freeswitch_ice_servers"
                                   placeholder="stun:stun.l.google.com:19302"/>
                        </group>
                        <group string="XML-RPC">
                            <field name="freeswitch_xmlrpc_host"
                                   placeholder="fs.example.com"/>
                            <field name="freeswitch_xmlrpc_port"
                                   placeholder="443"/>
                            <field name="freeswitch_xmlrpc_user"
                                   placeholder="freeswitch"/>
                            <field name="display_freeswitch_xmlrpc_password"
                                   password="True"
                                   placeholder="****"/>
                            <field name="freeswitch_xmlrpc_tls_verify"
                                   widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Log Levels">
                            <field name="freeswitch_log_level"/>
                            <field name="freeswitch_sofia_log_level"/>
                        </group>
                    </group>
                </page>
                <page name="firewall" string="Firewall">
                    <group>
                        <group string="Service">
                            <field name="firewall_enabled" widget="boolean_toggle"/>
                            <field name="firewall_service_url"
                                   placeholder="http://host.docker.internal:8081"/>
                            <field name="display_firewall_service_token"
                                   password="True"
                                   placeholder="**** (min 24 chars, [A-Za-z0-9_-])"/>
                        </group>
                        <group string="Heartbeat &amp; Retention">
                            <field name="firewall_heartbeat_interval"/>
                            <field name="firewall_event_retention_days"/>
                        </group>
                    </group>
                    <group>
                        <group string="Protected Ports">
                            <field name="firewall_tcp_ports"
                                   placeholder="5060,5061,5080,5081"/>
                            <field name="firewall_udp_ports"
                                   placeholder="5060,5061,5080,5081"/>
                        </group>
                        <group string="Timeouts (seconds)">
                            <field name="firewall_banned_timeout"/>
                            <field name="firewall_authenticated_timeout"/>
                            <field name="firewall_expire_short_timeout"/>
                            <field name="firewall_expire_long_timeout"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
