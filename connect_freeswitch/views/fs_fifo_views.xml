<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_connect_fs_fifo_tree" model="ir.ui.view">
        <field name="name">connect.fs_fifo.tree</field>
        <field name="model">connect.fs_fifo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="exten_number" string="Extension"/>
                <field name="max_wait_time"/>
                <field name="timeout_action"/>
            </list>
        </field>
    </record>

    <record id="view_connect_fs_fifo_form" model="ir.ui.view">
        <field name="name">connect.fs_fifo.form</field>
        <field name="model">connect.fs_fifo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="create_extension" type="object"
                                class="oe_stat_button" icon="fa-phone"
                                string="Extension"/>
                    </div>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="exten" readonly="1"/>
                            <field name="exten_number" readonly="1"/>
                            <field name="record_calls"/>
                        </group>
                        <group string="Queue Behavior">
                            <field name="max_wait_time"/>
                            <field name="moh_sound"/>
                            <field name="announce_position"/>
                        </group>
                    </group>
                    <group string="Timeout Action">
                        <group>
                            <field name="timeout_action"/>
                            <field name="voicemail_user_id"
                                   invisible="timeout_action != 'voicemail'"
                                   required="timeout_action == 'voicemail'"/>
                            <field name="fallback_exten_id"
                                   invisible="timeout_action != 'transfer'"
                                   required="timeout_action == 'transfer'"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="user_agents" string="User Agents">
                            <field name="member_user_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="exten_number"/>
                                </list>
                            </field>
                        </page>
                        <page name="endpoint_agents" string="Endpoint Agents">
                            <field name="member_endpoint_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="exten_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_connect_fs_fifo_search" model="ir.ui.view">
        <field name="name">connect.fs_fifo.search</field>
        <field name="model">connect.fs_fifo</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="exten_number"/>
            </search>
        </field>
    </record>

    <record id="action_connect_fs_fifo" model="ir.actions.act_window">
        <field name="name">FS Queues</field>
        <field name="res_model">connect.fs_fifo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_connect_fs_fifo"
              name="FS Queues"
              parent="connect.menu_connect_pbx"
              action="action_connect_fs_fifo"
              sequence="55"
              groups="connect.group_admin"/>

</odoo>
