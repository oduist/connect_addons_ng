<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_freeswitch_cdr_inbox_tree" model="ir.ui.view">
        <field name="name">connect.freeswitch.cdr.inbox.tree</field>
        <field name="model">connect.freeswitch.cdr.inbox</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'"
                  decoration-muted="state == 'done'"
                  decoration-info="state == 'processing'">
                <field name="create_date"/>
                <field name="uuid"/>
                <field name="chain_id"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="processed_at"/>
                <field name="last_error" optional="hide"/>
                <button name="action_retry" type="object" string="Retry"
                        icon="fa-refresh"
                        invisible="state != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_freeswitch_cdr_inbox_form" model="ir.ui.view">
        <field name="name">connect.freeswitch.cdr.inbox.form</field>
        <field name="model">connect.freeswitch.cdr.inbox</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_retry" type="object"
                            string="Retry"
                            class="oe_highlight"
                            invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="uuid"/>
                            <field name="chain_id"/>
                            <field name="create_date"/>
                            <field name="processed_at"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="ace" options="{'mode': 'xml'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_freeswitch_cdr_inbox_search" model="ir.ui.view">
        <field name="name">connect.freeswitch.cdr.inbox.search</field>
        <field name="model">connect.freeswitch.cdr.inbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="uuid"/>
                <field name="chain_id"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="processing" string="Processing"
                        domain="[('state', '=', 'processing')]"/>
                <filter name="failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_freeswitch_cdr_inbox" model="ir.actions.act_window">
        <field name="name">CDR Inbox</field>
        <field name="res_model">connect.freeswitch.cdr.inbox</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_freeswitch_cdr_inbox_search"/>
        <field name="context">{'search_default_failed': 1, 'search_default_pending': 1}</field>
    </record>

    <menuitem id="menu_freeswitch_cdr_inbox"
              name="CDR Inbox"
              parent="connect.menu_connect_settings"
              action="action_freeswitch_cdr_inbox"
              sequence="200"
              groups="connect.group_admin"/>

</odoo>
