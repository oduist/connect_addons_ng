<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_freeswitch_outgoing_route_tree" model="ir.ui.view">
        <field name="name">connect.freeswitch.outgoing_route.tree</field>
        <field name="model">connect.freeswitch.outgoing_route</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority"/>
                <field name="name"/>
                <field name="pattern"/>
                <field name="gateway"/>
                <field name="strip"/>
                <field name="prefix"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_freeswitch_outgoing_route_form" model="ir.ui.view">
        <field name="name">connect.freeswitch.outgoing_route.form</field>
        <field name="model">connect.freeswitch.outgoing_route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="pattern"/>
                            <field name="gateway"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="strip"/>
                            <field name="prefix"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_freeswitch_outgoing_route" model="ir.actions.act_window">
        <field name="name">Outgoing Routes</field>
        <field name="res_model">connect.freeswitch.outgoing_route</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_freeswitch_outgoing_route"
              name="Outgoing Routes"
              parent="connect_freeswitch.menu_connect_freeswitch"
              action="action_freeswitch_outgoing_route"
              sequence="71"
              groups="connect.group_admin"/>

</odoo>
