<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="partner_freeswitch_agent" model="res.partner">
        <field name="name">FreeSWITCH Agent</field>
    </record>

    <record id="user_freeswitch_agent" model="res.users">
        <field name="name">FreeSWITCH Agent</field>
        <field name="login">freeswitch_agent</field>
        <field name="partner_id" ref="partner_freeswitch_agent"/>
        <field name="share">True</field>
    </record>

    <!-- Add the agent to the FreeSWITCH Agent group.
         share=True on the user already gives it portal-tier access — adding
         it to base.group_portal explicitly conflicts with the agent group in
         Odoo 19's exclusive role checks. -->
    <record id="group_freeswitch_agent" model="res.groups">
        <field name="user_ids" eval="[(4, ref('user_freeswitch_agent'))]"/>
    </record>

</odoo>
