<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_crm_lead_webhook" model="ir.model.access">
        <field name="name">crm.lead webhook</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="group_id" ref="connect.group_webhook"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_mail_alias_domain_webhook" model="ir.model.access">
        <field name="name">mail.alias_domain webhook</field>
        <field name="model_id" ref="mail.model_mail_alias_domain"/>
        <field name="group_id" ref="connect.group_webhook"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_crm_stage_webhook" model="ir.model.access">
        <field name="name">crm.stage webhook</field>
        <field name="model_id" ref="crm.model_crm_stage"/>
        <field name="group_id" ref="connect.group_webhook"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_crm_team_webhook" model="ir.model.access">
        <field name="name">crm.team webhook</field>
        <field name="model_id" ref="crm.model_crm_team"/>
        <field name="group_id" ref="connect.group_webhook"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="crm_lead_webhook_rule" model="ir.rule">
        <field name="name">crm.lead webhook rule</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="groups" eval="[(4, ref('connect.group_webhook'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
