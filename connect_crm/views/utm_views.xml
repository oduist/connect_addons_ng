<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="utm_source_view_tree_connect_crm" model="ir.ui.view">
        <field name="name">utm.source.tree.connect_crm</field>
        <field name="model">utm.source</field>
        <field name="inherit_id" ref="utm.utm_source_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="phone"/>
            </field>
        </field>
    </record>

    <record id="utm_source_view_form_connect_crm" model="ir.ui.view">
        <field name="name">utm.source.form.connect_crm</field>
        <field name="model">utm.source</field>
        <field name="inherit_id" ref="utm.utm_source_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="phone"/>
            </field>
        </field>
    </record>

</odoo>
