<?xml version="1.0"?>
<!-- ======================================================================
     Odoo Connect CRM template for 3CX V20 (server-side integration).
     Generated by the Oduist Connect 3CX module: the Odoo URL and the
     webhook API key defaults are filled per instance at download time.
     Scenarios: contact lookup by number (empty Id), call journaling
     (ReportCall) and contact creation from 3CX clients. The template
     targets 3CX V20; the RecordingUrl / Transcription / Summary /
     Sentiment variables do not exist on older releases.
     ====================================================================== -->
<Crm Country="Global" Name="Odoo Connect" Version="1" SupportsEmojis="true">
  <Number Prefix="Plus" MaxLength="[MaxLength]"/>
  <Connection MaxConcurrentRequests="2"/>
  <Parameters>
    <Parameter Name="OdooUrl" Type="String" Parent="General Configuration" Editor="String" Title="Odoo URL:" Validation="" Default="$odoo_url" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ApiKey" Type="Password" Parent="General Configuration" Editor="String" Title="API Key (from Connect Settings, 3CX):" Validation="" Default="$api_key" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="ReportCallEnabled" Type="Boolean" Parent="General Configuration" Editor="String" Title="Enable Call Journaling" Validation="" Default="True" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
    <Parameter Name="CreateContactEnabled" Type="Boolean" Parent="General Configuration" Editor="String" Title="Allow contact creation directly to Odoo using 3CX clients" Validation="" Default="True" ListValues="" RequestUrl="" RequestUrlParameters="" ResponseScenario="" />
  </Parameters>
  <!-- Auth is a custom header (X-Connect-Api-Key) added per request. -->
  <Authentication Type="No" />
  <Scenarios>
    <!-- ==================================================================
         Contact lookup by phone number (fires at call arrival, both
         directions). Odoo answers {"contact": {...}} or {} for no match.
         ================================================================== -->
    <Scenario Id="" Type="REST">
      <Request SkipIf="" Url="[OdooUrl]/3cx/webhook/lookup?number=[[Number].Replace(&quot;+&quot;,&quot;%2B&quot;)]&amp;direction=[CallDirection]" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="UrlEncoded" RequestType="Get" ResponseType="Json">
        <Headers>
          <Value Key="X-Connect-Api-Key" Passes="0">[ApiKey]</Value>
        </Headers>
      </Request>
      <Rules>
        <Rule Type="Any" Ethalon="">contact.id</Rule>
      </Rules>
      <Variables>
        <Variable Name="ContactId" LookupValue="" Path="contact.id"><Filter /></Variable>
        <Variable Name="OdUrl" LookupValue="" Path="contact.url"><Filter /></Variable>
        <Variable Name="OdFirstName" LookupValue="" Path="contact.first_name"><Filter /></Variable>
        <Variable Name="OdLastName" LookupValue="" Path="contact.last_name"><Filter /></Variable>
        <Variable Name="OdCompany" LookupValue="" Path="contact.company_name"><Filter /></Variable>
        <Variable Name="OdEntityType" LookupValue="" Path="contact.entity_type"><Filter /></Variable>
        <Variable Name="OdPhone" LookupValue="" Path="contact.phone_business"><Filter /></Variable>
        <Variable Name="OdMobile" LookupValue="" Path="contact.phone_mobile"><Filter /></Variable>
        <Variable Name="OdEmail" LookupValue="" Path="contact.email"><Filter /></Variable>
      </Variables>
      <Outputs AllowEmpty="true">
        <Output Type="ContactUrl" Passes="1" Value="[OdUrl]" />
        <Output Type="EntityId" Passes="1" Value="[ContactId]" />
        <Output Type="EntityType" Passes="1" Value="[OdEntityType]" />
        <Output Type="FirstName" Passes="1" Value="[OdFirstName]" />
        <Output Type="LastName" Passes="1" Value="[OdLastName]" />
        <Output Type="CompanyName" Passes="1" Value="[OdCompany]" />
        <Output Type="PhoneBusiness" Passes="1" Value="[OdPhone]" />
        <Output Type="PhoneMobile" Passes="1" Value="[OdMobile]" />
        <Output Type="Email" Passes="1" Value="[OdEmail]" />
      </Outputs>
    </Scenario>
    <!-- ==================================================================
         Call journaling: one POST at call end. Gated only on the
         ReportCallEnabled parameter (NOT on EntityId): the Odoo call
         ledger records every external call, matched or not.
         ================================================================== -->
    <Scenario Id="ReportCall" Type="REST">
      <Request SkipIf="[ReportCallEnabled]!=True" Url="[OdooUrl]/3cx/webhook/report_call" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="Json" RequestType="Post" ResponseType="Json">
        <Headers>
          <Value Key="X-Connect-Api-Key" Passes="0">[ApiKey]</Value>
        </Headers>
        <PostValues>
          <Value Key="call_type" If="" SkipIf="" Passes="1" Type="String">[CallType]</Value>
          <Value Key="direction" If="" SkipIf="" Passes="1" Type="String">[CallDirection]</Value>
          <Value Key="number" If="" SkipIf="" Passes="1" Type="String">[Number]</Value>
          <Value Key="contact_name" If="" SkipIf="" Passes="1" Type="String">[Name]</Value>
          <Value Key="entity_id" If="" SkipIf="" Passes="1" Type="String">[EntityId]</Value>
          <Value Key="entity_type" If="" SkipIf="" Passes="1" Type="String">[EntityType]</Value>
          <Value Key="queue_extension" If="" SkipIf="" Passes="1" Type="String">[QueueExtension]</Value>
          <Value Key="agent" If="" SkipIf="" Passes="1" Type="String">[Agent]</Value>
          <Value Key="agent_email" If="" SkipIf="" Passes="1" Type="String">[AgentEmail]</Value>
          <Value Key="duration" If="" SkipIf="" Passes="1" Type="String">[Duration]</Value>
          <Value Key="start_utc_millis" If="" SkipIf="" Passes="1" Type="String">[CallStartTimeUTCMillis]</Value>
          <Value Key="established_utc_millis" If="" SkipIf="" Passes="1" Type="String">[CallEstablishedTimeUTCMillis]</Value>
          <Value Key="end_utc_millis" If="" SkipIf="" Passes="1" Type="String">[CallEndTimeUTCMillis]</Value>
          <Value Key="recording_url" If="" SkipIf="" Passes="1" Type="String">[RecordingUrl]</Value>
          <Value Key="transcription" If="" SkipIf="" Passes="1" Type="String">[Transcription]</Value>
          <Value Key="summary" If="" SkipIf="" Passes="1" Type="String">[Summary]</Value>
          <Value Key="sentiment" If="" SkipIf="" Passes="1" Type="String">[Sentiment]</Value>
        </PostValues>
      </Request>
    </Scenario>
    <!-- ==================================================================
         Contact creation from a 3CX client (unmatched caller). Odoo
         returns the full contact record, so no fetch chain is needed.
         ================================================================== -->
    <Scenario Id="CreateContactRecordFromClient" Type="REST">
      <Request SkipIf="[CreateContactEnabled]!=True" Url="[OdooUrl]/3cx/webhook/create_contact" MessagePasses="0" Message="" RequestContentType="" RequestEncoding="Json" RequestType="Post" ResponseType="Json">
        <Headers>
          <Value Key="X-Connect-Api-Key" Passes="0">[ApiKey]</Value>
        </Headers>
        <PostValues>
          <Value Key="first_name" If="" SkipIf="" Passes="1" Type="String">[FirstName]</Value>
          <Value Key="last_name" If="" SkipIf="" Passes="1" Type="String">[LastName]</Value>
          <Value Key="number" If="" SkipIf="" Passes="1" Type="String">[Number]</Value>
          <Value Key="email" If="" SkipIf="" Passes="1" Type="String">[Email]</Value>
          <Value Key="company" If="" SkipIf="" Passes="1" Type="String">[Company]</Value>
        </PostValues>
      </Request>
      <Rules>
        <Rule Type="Any" Ethalon="">contact.id</Rule>
      </Rules>
      <Variables>
        <Variable Name="ContactId" LookupValue="" Path="contact.id"><Filter /></Variable>
        <Variable Name="OdUrl" LookupValue="" Path="contact.url"><Filter /></Variable>
        <Variable Name="OdFirstName" LookupValue="" Path="contact.first_name"><Filter /></Variable>
        <Variable Name="OdLastName" LookupValue="" Path="contact.last_name"><Filter /></Variable>
        <Variable Name="OdCompany" LookupValue="" Path="contact.company_name"><Filter /></Variable>
        <Variable Name="OdEntityType" LookupValue="" Path="contact.entity_type"><Filter /></Variable>
        <Variable Name="OdPhone" LookupValue="" Path="contact.phone_business"><Filter /></Variable>
        <Variable Name="OdMobile" LookupValue="" Path="contact.phone_mobile"><Filter /></Variable>
        <Variable Name="OdEmail" LookupValue="" Path="contact.email"><Filter /></Variable>
      </Variables>
      <Outputs AllowEmpty="false">
        <Output Type="ContactUrl" Passes="1" Value="[OdUrl]" />
        <Output Type="EntityId" Passes="1" Value="[ContactId]" />
        <Output Type="EntityType" Passes="1" Value="[OdEntityType]" />
        <Output Type="FirstName" Passes="1" Value="[OdFirstName]" />
        <Output Type="LastName" Passes="1" Value="[OdLastName]" />
        <Output Type="CompanyName" Passes="1" Value="[OdCompany]" />
        <Output Type="PhoneBusiness" Passes="1" Value="[OdPhone]" />
        <Output Type="PhoneMobile" Passes="1" Value="[OdMobile]" />
        <Output Type="Email" Passes="1" Value="[OdEmail]" />
      </Outputs>
    </Scenario>
  </Scenarios>
</Crm>
