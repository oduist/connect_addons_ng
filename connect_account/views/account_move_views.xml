<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="connect_calls_account_action" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">connect.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('invoice', '=', active_id)]</field>
    </record>

    <record id="view_move_form_connect_account" model="ir.ui.view">
        <field name="name">connect_account.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(connect_calls_account_action)d" type="action"
                        class="oe_stat_button" icon="fa-phone"
                        groups="connect.group_user">
                    <field name="connect_calls_count" string="Calls" widget="statinfo"/>
                </button>
            </xpath>
            <field name="partner_id" position="after">
                <field name="partner_phone" readonly="1"/>
                <field name="partner_mobile" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_connect_account" model="ir.ui.view">
        <field name="name">connect_account.account.invoice.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_phone"/>
                <field name="partner_mobile"/>
            </field>
        </field>
    </record>

</odoo>
