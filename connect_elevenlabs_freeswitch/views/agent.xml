<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="connect_elevenlabs_agent_form_freeswitch" model="ir.ui.view">
        <field name="name">connect_elevenlabs_agent_form_freeswitch</field>
        <field name="model">connect.elevenlabs_agent</field>
        <field name="inherit_id" ref="connect_elevenlabs.connect_elevenlabs_agent_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='conversation']" position="after">
                <page name="freeswitch" string="FreeSWITCH">
                    <group>
                        <field name="fs_transport"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>SIP Trunk:</strong>
                        Provision a SIP trunk in the ElevenLabs dashboard, then create a
                        <code>connect.freeswitch.gateway</code> record named
                        <code>elevenlabs</code> with the credentials it provides. See
                        <em>docs/admin/elevenlabs-freeswitch.md</em>.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
