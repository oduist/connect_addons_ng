<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="connect_calls_hr_action" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">connect.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee', '=', active_id)]</field>
    </record>

    <record id="view_employee_form_connect_hr" model="ir.ui.view">
        <field name="name">connect_hr.hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(connect_calls_hr_action)d" type="action"
                        class="oe_stat_button" icon="fa-phone">
                    <field name="connect_calls_count" string="Calls" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_employee_filter_connect_hr" model="ir.ui.view">
        <field name="name">connect_hr.hr.employee.search</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="work_phone"/>
                <field name="mobile_phone"/>
            </field>
        </field>
    </record>

</odoo>
