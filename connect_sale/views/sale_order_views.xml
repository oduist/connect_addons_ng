<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="connect_calls_sale_action" model="ir.actions.act_window">
        <field name="name">Calls</field>
        <field name="res_model">connect.call</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sale_order', '=', active_id)]</field>
    </record>

    <record id="view_order_form_connect_sale" model="ir.ui.view">
        <field name="name">connect_sale.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(connect_calls_sale_action)d" type="action"
                        class="oe_stat_button" icon="fa-phone"
                        groups="connect.group_user">
                    <field name="connect_calls_count" string="Calls" widget="statinfo"/>
                </button>
            </xpath>
            <field name="partner_id" position="after">
                <field name="partner_phone" widget="phone" readonly="1"/>
                <field name="partner_mobile" widget="phone" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_quotation_connect_sale" model="ir.ui.view">
        <field name="name">connect_sale.sale.order.search.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_phone"/>
                <field name="partner_mobile"/>
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_sale_connect_sale" model="ir.ui.view">
        <field name="name">connect_sale.sale.order.search.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_phone"/>
                <field name="partner_mobile"/>
            </field>
        </field>
    </record>

</odoo>
