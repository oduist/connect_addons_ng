<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_connect_call_tree_sale" model="ir.ui.view">
        <field name="name">connect.call.tree.sale</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_tree"/>
        <field name="arch" type="xml">
            <field name="partner" position="after">
                <field name="sale_order" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_connect_call_form_sale" model="ir.ui.view">
        <field name="name">connect.call.form.sale</field>
        <field name="model">connect.call</field>
        <field name="inherit_id" ref="connect.view_connect_call_form"/>
        <field name="arch" type="xml">
            <button name="create_partner_button" position="after">
                <button string="Sale Order" name="create_sale_order_button" type="object"
                        class="oe_stat_button" icon="fa-shopping-cart"/>
            </button>
            <notebook position="inside">
                <page name="sale" string="Sale Order">
                    <group>
                        <group>
                            <field name="sale_order"/>
                        </group>
                        <group>
                            <button name="unlink_sale_order" type="object" string="Unlink"
                                    invisible="not sale_order"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
