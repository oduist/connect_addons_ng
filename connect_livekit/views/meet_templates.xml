<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone public meeting page. It deliberately does NOT use an
         Odoo asset bundle: bundled JS is wrapped in Odoo's module system,
         which never starts on a bare public page (no web client boot), so
         the widget would never run. Instead the vendored SDK and the page
         script are referenced as plain static files and the styles are
         inlined as plain CSS. -->
    <template id="meet_page" name="LiveKit Meeting">
        &lt;!DOCTYPE html&gt;
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title><t t-esc="room_title"/></title>
                <link rel="stylesheet" href="/connect_livekit/static/src/meet/meet.css"/>
                <script type="text/javascript"
                        src="/connect_livekit/static/lib/livekit-client.umd.min.js"/>
                <script type="text/javascript"
                        src="/connect_livekit/static/src/meet/meet.js" defer="defer"/>
            </head>
            <body>
                <div id="lk-meet"
                     t-att-data-guest-token="guest_token"
                     t-att-data-room-title="room_title"/>
            </body>
        </html>
    </template>
</odoo>
