<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_livekit_number_list" model="ir.ui.view">
        <field name="name">connect.livekit.number.list</field>
        <field name="model">connect.livekit.number</field>
        <field name="arch" type="xml">
            <list>
                <field name="phone_number"/>
                <field name="friendly_name"/>
                <field name="trunk"/>
                <field name="destination"/>
                <field name="user" optional="show"/>
                <field name="agent" optional="show"/>
                <field name="room" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_livekit_number_form" model="ir.ui.view">
        <field name="name">connect.livekit.number.form</field>
        <field name="model">connect.livekit.number</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="phone_number" placeholder="+15551234567"/></h1>
                    </div>
                    <group>
                        <group string="Number">
                            <field name="friendly_name"/>
                            <field name="trunk"/>
                            <field name="dispatch_rule_sid"/>
                        </group>
                        <group string="Routing">
                            <field name="destination"/>
                            <field name="user" invisible="destination != 'user'"
                                   required="destination == 'user'"/>
                            <field name="agent" invisible="destination != 'agent'"
                                   required="destination == 'agent'"/>
                            <field name="room" invisible="destination != 'room'"
                                   required="destination == 'room'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_livekit_number" model="ir.actions.act_window">
        <field name="name">Numbers</field>
        <field name="res_model">connect.livekit.number</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_livekit_numbers"
              name="Numbers"
              parent="menu_connect_livekit"
              action="action_livekit_number"
              groups="connect.group_admin"
              sequence="30"/>
</odoo>
