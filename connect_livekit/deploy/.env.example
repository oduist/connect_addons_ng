# Copy to .env and fill in. Used by docker-compose.yml.
# The paired Odoo instance URL (reachable from this host).
ODOO_URL=https://odoo.example.com
# From Odoo: LiveKit Settings -> GENERATE AGENT TOKEN.
AGENT_TOKEN=
# Must match the key/secret in livekit.yaml / sip.yaml / egress.yaml.
LIVEKIT_API_KEY=APIconnect
LIVEKIT_API_SECRET=
# Fallback AI keys for the agent worker (normally delivered by Odoo).
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
